# Servicio realtime (NestJS + Socket.IO).
#
# Copiar este archivo a realtime/.env y completar los valores.
# NO versionar .env con secretos reales.

# --- Identidad de sesión -----------------------------------------------------
# Debe ser EXACTAMENTE el mismo valor que SECRET_KEY en back/.env.
# NestJS valida la firma HS256 del JWT emitido por Flask y su expiración.
# setup.ps1/setup.sh reemplazan este placeholder por la clave de Flask.
# Una clave existente diferente se preserva y detiene la instalación.
REALTIME_JWT_SECRET=cambia-esto-por-el-mismo-valor-que-SECRET_KEY

# --- Secreto HMAC servidor-a-servidor ----------------------------------------
# Se lee del archivo dentro del volumen privado compartido con Flask.
# El valor real NO se define aquí: backend y realtime leen el mismo archivo.
REALTIME_HMAC_SECRET_FILE=/var/lib/cs2-matchmaking/realtime_hmac_secret

# --- Socket.IO ---------------------------------------------------------------
# Path público (nginx lo reenvía tal cual a NestJS).
REALTIME_SOCKET_PATH=/realtime/socket.io
# Orígenes permitidos por el handshake (coma separados). En Docker, el
# navegador usa el mismo origen que nginx; incluir la URL pública real.
REALTIME_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
# Rechazar conexiones sin cabecera Origin (los navegadores siempre la envían).
REALTIME_ALLOW_MISSING_ORIGIN=false

# --- Verificación opcional de identidad contra Flask -------------------------
# Confirma que el usuario del JWT sigue existiendo antes de aceptar el socket.
REALTIME_IDENTITY_VERIFY=true
# Si Flask no responde, rechazar la conexión (false) o aceptarla (true).
REALTIME_IDENTITY_FAIL_OPEN=false
REALTIME_FLASK_IDENTITY_URL=http://backend:5000/internal/realtime/identity
REALTIME_IDENTITY_TIMEOUT_MS=2000
REALTIME_IDENTITY_CACHE_TTL_SECONDS=30

# --- Ventanas de validez y replay -------------------------------------------
REALTIME_EVENT_MAX_AGE_SECONDS=300
REALTIME_EVENT_FUTURE_SKEW_SECONDS=30
# Debe superar 2 * REALTIME_EVENT_MAX_AGE_SECONDS para evitar replay en el
# extremo adelantado de la ventana de timestamps. El arranque valida esta regla.
REALTIME_NONCE_TTL_SECONDS=900
REALTIME_EVENT_ID_TTL_SECONDS=3600

# --- Límites de conexión y mensajes -----------------------------------------
REALTIME_MAX_CONNECTIONS_PER_USER=5
REALTIME_MAX_CONNECTIONS_PER_IP=25
REALTIME_MAX_CONNECTION_ATTEMPTS_PER_MINUTE=30
REALTIME_WS_MAX_BUFFER_BYTES=16384
REALTIME_WS_MESSAGES_PER_MINUTE=20

# --- Presencia ---------------------------------------------------------------
# Margen anti-parpadeo antes de difundir ONLINE/OFFLINE (segundos).
# 0 desactiva el agrupamiento (útil en tests).
REALTIME_PRESENCE_GRACE_SECONDS=15
